SMARTTHINGS_TOKEN=
SMARTTHINGS_DEVICE=
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=
INFLUX_ORG=nanoCorp
INFLUX_BUCKET=nano
POLL_INTERVAL_SEC=240

# OAuth (recommended, tokens refresh automatically). When set, SMARTTHINGS_TOKEN is not needed.
# One-time setup: node --env-file=.env src/st-auth.mjs url   then   ... exchange <code>
ST_CLIENT_ID=
ST_CLIENT_SECRET=
ST_REDIRECT_URI=
# ST_SCOPE=r:devices:*
# ST_TOKEN_FILE=data/smartthings-token.json

